# * Local Nuxt env. Copy to `.env` and fill in real values.
# * Variables prefixed NUXT_PUBLIC_ are exposed to the browser bundle —
# * never put a secret behind that prefix.

# --- Supabase (Nuxt side) ---
NUXT_PUBLIC_SUPABASE_URL=https://hznvltijxkeadqpwctop.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxx                    # * anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=                                      # * server-only, never exposed

# --- Magic-link base (same value as SITE_URL on Supabase functions side) ---
NUXT_PUBLIC_SITE_URL=https://intesport-web.netlify.app

# --- SystemPay (Lyra) Smartform — browser side ---
NUXT_PUBLIC_SYSTEMPAY_ENDPOINT=api.systempay.fr                # * bare hostname, no scheme
NUXT_PUBLIC_SYSTEMPAY_PUBLIC_KEY=12345678:testpublickey_xxxxx  # * test mode prefix → swap for prod

# --- Email (Brevo) — only needed if running edge functions locally ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
